{
  "plugin": "custom",
  "pluginConfig": {
    "invoke_interval": "10s",
    "timeout": "5s",
    "max_output_length": 80,
    "concurrency": 3,
    "enable_message_change_based_condition_update": false
  },
  "source": "custom-plugin-gpu-xid",
  "metricsReporting": false,
  "conditions": [
    { "type": "GpuXid", "reason": "GpuXidGood", "message": "GPU XID is ok" }
  ],
  "rules": [
    {
      "type": "temporary",
      "reason": "GpuXidBad",
      "path": "./config/plugin/temp_rule_check_gpu_xid.sh",
      "timeout": "5s"
    },
    {
      "type": "permanent",
      "condition": "GpuXid",
      "reason": "GpuXidBad",
      "path": "./config/plugin/perm_rule_check_gpu_xid.sh",
      "timeout": "5s"
    }
  ]
}
