{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug current file",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${file}"
    },
    {
      "name": "Debug package main",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/operator",
      "env": {
        "TELEMETRY_URL": "http://localhost:8080"
      },
      "args": []
    },
    {
      "name": "Debug current test file",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}"
    },
    {
      "name": "Debug single test (prompt for name)",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "args": ["-test.run", "${input:testName}", "-test.v"]
    },
    {
      "name": "Attach to running process",
      "type": "go",
      "request": "attach",
      "mode": "local",
      "processId": 0
    }
  ],
  "inputs": [
    {
      "id": "testName",
      "type": "promptString",
      "description": "Test name regex (e.g. TestReconcile_Draining)"
    }
  ]
}
